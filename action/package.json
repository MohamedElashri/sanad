{
  "name": "sanad-action",
  "version": "1.0.1",
  "private": true,
  "description": "GitHub Action wrapper for Sanad",
  "main": "dist/index.js",
  "scripts": {
    "build": "node build.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node test/integration.js",
    "check-dist": "npm run build && git diff --exit-code -- dist"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "1.11.1",
    "@actions/exec": "1.1.1",
    "@actions/tool-cache": "2.0.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=24"
  }
}
