{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melashri.net/sanad/schema/plan-v1.schema.json",
  "title": "Sanad plan and apply report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "summary", "files"],
  "properties": {
    "version": { "const": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "already_pinned", "updates_available", "pending_cooldown", "policy_violations", "skipped"],
      "properties": {
        "actions": { "type": "integer", "minimum": 0 },
        "already_pinned": { "type": "integer", "minimum": 0 },
        "updates_available": { "type": "integer", "minimum": 0 },
        "pending_cooldown": { "type": "integer", "minimum": 0 },
        "policy_violations": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "actions"],
        "properties": {
          "path": { "type": "string" },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["node_path", "line", "column", "raw", "kind", "decision", "reason_code"],
              "properties": {
                "node_path": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "column": { "type": "integer", "minimum": 1 },
                "raw": { "type": "string" },
                "inline_comment": { "type": "string" },
                "owner": { "type": "string" },
                "repo": { "type": "string" },
                "path": { "type": "string" },
                "kind": { "type": "string" },
                "logical_ref": { "type": "string" },
                "metadata_source": { "type": "string" },
                "current_sha": { "type": "string" },
                "candidate_sha": { "type": "string" },
                "candidate_ref_kind": { "type": "string" },
                "decision": { "type": "string" },
                "reason_code": { "type": "string" },
                "reason": { "type": "string" },
                "age": { "type": "string" },
                "age_seconds": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
